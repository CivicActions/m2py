// MUMPS Command Grammar for textX
// =============================================================================
// Commands: SET, WRITE, READ, IF, FOR, GOTO, DO, QUIT, NEW, etc.
// Combined with expression grammar for standalone use.
// =============================================================================

// Import expression grammar
import expressions

// =============================================================================
// Commands
// =============================================================================

// A command with optional postcondition
Command:
    SetCommand |
    WriteCommand |
    ReadCommand |
    IfCommand |
    ElseCommand |
    ForCommand |
    GotoCommand |
    DoCommand |
    QuitCommand |
    NewCommand |
    KillCommand |
    HaltCommand |
    HangCommand |
    BreakCommand |
    LockCommand |
    MergeCommand |
    ViewCommand |
    XecuteCommand |
    JobCommand |
    OpenCommand |
    CloseCommand |
    UseCommand
;

// =============================================================================
// Assignment Commands
// =============================================================================

// SET command: S|SET target=value,target=value,...
SetCommand:
    /[Ss][Ee][Tt]|[Ss]/ postcond=Postcondition? WS assignments+=SetArgument[/,/]
;

// SET argument: can be a regular assignment, or argument-level indirection
// Argument-level indirection (@VAR) contains the complete "target=value" text
SetArgument:
    Assignment | SetIndirection
;

// Argument-level indirection in SET: @VAR where VAR contains "target=value"
SetIndirection:
    indirect=Indirection
;

// Single assignment: target=value or (targets)=value
Assignment:
    targets=SetTargets '=' value=Expr postcond=Postcondition?
;

// Set targets: single variable/global or parenthesized list
SetTargets:
    ParenTargets | SingleTarget
;

ParenTargets:
    '(' targets+=SingleTarget[/,/] ')'
;

// NakedGlobal MUST come before GlobalVariable since both start with ^
// NakedGlobal is ^(...) while GlobalVariable is ^name(...)
// IntrinsicFunction supports left-hand $PIECE: $P(var,"^")="value"
SingleTarget:
    NakedGlobal | GlobalVariable | LocalVariable | Indirection | IntrinsicFunction
;

// =============================================================================
// I/O Commands
// =============================================================================

// WRITE command: W|WRITE args
// Format controls (!, #) can be adjacent without commas
// Other args need comma separation
WriteCommand:
    /[Ww][Rr][Ii][Tt][Ee]|[Ww]/ postcond=Postcondition? WS? args*=WriteArg
;

// Write argument: format control or expression with optional postcondition
// Comma is optional before format controls but required between expressions
WriteArg:
    /,/? postcond=Postcondition? arg=WriteArgValue
;

WriteArgValue:
    FormatControl | Expr
;

// Format controls: !, #, ?n, *n (newline, form feed, column, char code)
FormatControl:
    Newline | FormFeed | Tab | CharCode
;

Newline: val='!';
FormFeed: val='#';
Tab: val=/\?/ expr=Expr;
CharCode: val=/\*/ expr=Expr;

// READ command: R|READ args
// Format controls (!, #) can be adjacent without commas (like WRITE)
// Other args need comma separation
ReadCommand:
    /[Rr][Ee][Aa][Dd]|[Rr]/ postcond=Postcondition? WS? args*=ReadArg
;

// Read argument: can be format control, prompt, or variable target
// Valid forms:
//   ! or # or ?n - format control only (output to device)
//   "prompt" - string literal prompt (output to device)
//   VAR or VAR:timeout - variable read (input from device)
//   *VAR or *VAR:timeout - single char read
//   "prompt",VAR:timeout - prompt followed by read
//   !!?10,"prompt",VAR - multiple format/prompt before variable (! adjacent)
ReadArg:
    /,/? postcond=Postcondition? arg=ReadArgValue
;

ReadArgValue:
    // Format controls (can be adjacent without comma)
    ReadFormat |
    // Prompt string
    StringLiteral |
    // Target with optional timeout
    ReadTargetWithTimeout
;

ReadTargetWithTimeout:
    target=ReadTarget ('#' fixed_length=Expr)? (':' timeout=Expr)?
;

// Format controls valid in READ (not * which is CharRead)
ReadFormat:
    Newline | FormFeed | Tab
;

// ReadTarget: variable to read into
// FixedLengthRead is handled at ReadTargetWithTimeout level with #length syntax
ReadTarget:
    CharRead | GlobalVariable | LocalVariable | Indirection
;

CharRead:
    /\*/ var=LocalVariable
;

// =============================================================================
// Control Flow - Conditional
// =============================================================================

// IF command: I|IF conditions (comma-separated = AND)
// Per MUMPS spec: "IF with n arguments is equivalent to n IFs"
// IMPORTANT: Uses single space (not WS) to distinguish:
//   - "I 1 S X=1" = IF with condition 1, then SET (one space after I)
//   - "I  S X=1"  = argumentless IF, then SET (two spaces = command separator)
IfCommand:
    /[Ii][Ff]|[Ii]/ (/[ \t]/ conditions+=Expr[/,/])?
;

// ELSE command: E|ELSE
ElseCommand:
    /[Ee][Ll][Ss][Ee]|[Ee]/ postcond=Postcondition?
;

// =============================================================================
// Control Flow - Loops
// =============================================================================

// FOR command: F|FOR var=forparams or argumentless FOR
// Note: var can be a subscripted variable like J(1,2,3)
// Also supports indirection: FOR @A=1:1:10
ForCommand:
    /[Ff][Oo][Rr]|[Ff]/ (WS (indirect=Indirection | var=LocalVariable) '=' params+=ForParam[/,/])?
;

// FOR parameter: value, start:step, or start:step:end
ForParam:
    start=Expr (':' step=Expr (':' end=Expr)?)?
;

// =============================================================================
// Control Flow - Branching
// =============================================================================

// GOTO command: G|GOTO targets
GotoCommand:
    /[Gg][Oo][Tt][Oo]|[Gg]/ postcond=Postcondition? WS targets+=GotoTarget[/,/]
;

// GOTO target: label, label+offset, label^routine, label+offset^routine
// Or indirection: @expr, @@expr, @expr+offset, @expr^routine
// Postcondition comes AFTER the label: G ABC:X=1
GotoTarget:
    (
        // Indirection: @expr, @@expr, @expr+offset, @expr^routine, etc.
        indirect=GotoIndirect |
        // Regular label reference
        label=LabelRef
    ) postcond=Postcondition?
;

// GOTO indirection: Supports full label reference structure
// including nested indirection (@@, @@@), offset, and routine components
// Patterns: @VAR, @@VAR, @(expr), @VAR+offset, @VAR^routine, @VAR+offset^routine
GotoIndirect:
    labelIndirect=IndirectChain
    ('+' offset=OffsetExpr?)?
    ('^' (routineIndirect=IndirectChain | routine=VARNAME))?
;

// DO command: D|DO targets or argumentless DO
DoCommand:
    /[Dd][Oo]|[Dd]/ postcond=Postcondition? (WS targets+=DoTarget[/,/])?
;

// DO target: label reference, indirection, or label with args
// Postcondition comes AFTER the label/indirection: D ABC:X=1
DoTarget:
    (
        // Indirection: @expr, @@expr, @expr+offset, @expr^routine, etc.
        indirect=DoIndirect |
        // Regular label reference
        label=LabelRef args=FunctionArgs?
    ) postcond=Postcondition?
;

// DO indirection: Supports full label reference structure
// with nested indirection (@@, @@@), offset, routine, and arguments
// Patterns: @VAR, @@VAR, @(expr), @VAR+offset, @VAR^routine, @VAR+offset^routine
DoIndirect:
    labelIndirect=IndirectChain
    ('+' offset=OffsetExpr?)?
    ('^' (routineIndirect=IndirectChain | routine=VARNAME))?
    args=FunctionArgs?
;

// Indirection chain: handles nested indirection like @@VAR or @@@VAR
// Each @ adds a level of indirection (runtime dereference)
IndirectChain:
    '@' (
        // Nested indirection: @@VAR, @@@VAR, etc.
        nested=IndirectChain |
        // Parenthesized expression: @(expr)
        '(' expr=Expr ')' |
        // Global variable: @^VAR or @^VAR(subscripts)
        global=GlobalVariable |
        // Simple variable: @VAR or @VAR(subscripts)
        var=LocalVariable
    )
    // Name indirection subscripts: @(subscripts) after the main indirection
    // Used in DO/GOTO targets like DO @X@(1) to append subscripts to the indirect name
    name_subscripts+=NameIndirectionSubscripts*
;

// Label reference: label, label+offset, label^routine, label+^routine, ^routine
// NOTE: MUMPS labels can be numeric (1, 012, 0) or alphanumeric (%ABC, LABEL1)
// Uses OffsetExpr instead of Expr to prevent consuming ^routine as a global variable
// The offset is optional when immediately followed by ^routine (means offset 0):
//   G LABEL+^ROUTINE is equivalent to G LABEL+0^ROUTINE
// Routine can be either a literal name or an indirect expression: LABEL^ROUTINE or LABEL^@VAR
LabelRef:
    (label=LABELNAME ('+' offset=OffsetExpr?)?)? 
    ('^' (routineIndirect=IndirectChain | routine=VARNAME))?
;

// Label name - can be:
// - Purely numeric (1, 012, 0) 
// - Start with % followed by alphanumeric (%ABC, %0000000)
// - Start with letter followed by alphanumeric (LABEL, A1B2)
LABELNAME:
    /[0-9]+|[%A-Za-z][A-Za-z0-9]*/
;

// QUIT command: Q|QUIT with optional return value
// NOTE: Must not consume command keywords as return value
// Using negative lookahead to prevent "Q S X" from treating "S" as value
// Key: Command keyword followed by space+arg pattern indicates next command
QuitCommand:
    /[Qq][Uu][Ii][Tt]|[Qq]/ postcond=Postcondition? (SingleSpace !CommandWithArg value=Expr)?
;

// Pattern: Command keyword followed by space + likely argument pattern
// This distinguishes "Q S X=1" (QUIT then SET) from "Q X" (QUIT with value)
// Note: SET requires whitespace between S and the target variable
// CRITICAL: Also detect command keywords followed by : (postcondition)
// NOTE: "S=1" is a valid MUMPS expression (comparison), NOT a SET command
//       SET requires: S<space>VAR= not S=
// This pattern detects UNAMBIGUOUS command starts that cannot be confused
// with variable names in expressions. We use conservative matching:
// - Full command words (SET, WRITE, etc.) are always commands
// - Postconditioned abbreviations (S:, W:, etc.) are always commands
// - Single-letter + space + clear target patterns (S $P, S %VAR, S @X)
// The line.tx grammar handles command separation, so we just need to prevent
// QUIT from consuming what is clearly the start of another command.
CommandWithArg:
    // Full command words are unambiguous
    /[Ss][Ee][Tt][ \t:]/ |
    /[Ww][Rr][Ii][Tt][Ee][ \t:]/ |
    /[Rr][Ee][Aa][Dd][ \t:]/ |
    /[Ii][Ff][ \t:]|[Ii][Ff]$/ |
    /[Ee][Ll][Ss][Ee]/ |
    /[Ff][Oo][Rr][ \t:]/ |
    /[Gg][Oo][Tt][Oo][ \t:]/ |
    /[Dd][Oo][ \t:]/ |
    /[Qq][Uu][Ii][Tt]/ |
    /[Nn][Ee][Ww][ \t:]/ |
    /[Kk][Ii][Ll][Ll][ \t:]/ |
    /[Bb][Rr][Ee][Aa][Kk]/ |
    /[Jj][Oo][Bb][ \t:]/ |
    /[Oo][Pp][Ee][Nn][ \t:]/ |
    /[Cc][Ll][Oo][Ss][Ee][ \t:]/ |
    /[Uu][Ss][Ee][ \t:]/ |
    /[Hh][Aa][Nn][Gg][ \t:]/ |
    /[Hh][Aa][Ll][Tt]/ |
    /[Ll][Oo][Cc][Kk][ \t:]/ |
    /[Mm][Ee][Rr][Gg][Ee][ \t:]/ |
    /[Vv][Ii][Ee][Ww][ \t:]/ |
    /[Xx][Ee][Cc][Uu][Tt][Ee][ \t:]/ |
    // Postconditioned single-letter commands are unambiguous (colon after letter)
    /[SsWwRrIiFfGgDdQqNnKkBbJjOoCcUuLlMmVvXxEeHh]:/ |
    // Single-letter S/W/R/I/K followed by space is always a command (not part of expression)
    // "S X" after QUIT = SET command (not variable S with value X)
    // "X S=1" = variable X with comparison S=1, but space between makes it X (QUIT value), then SET
    /[Ss][ \t]/ |
    /[Ww][ \t]/ |
    /[Rr][ \t]/ |
    /[Ii][ \t]/ |
    /[Kk][ \t]/
;

// =============================================================================
// Variable Management
// =============================================================================

// NEW command: N|NEW vars or exclusive NEW
NewCommand:
    /[Nn][Ee][Ww]|[Nn]/ postcond=Postcondition? WS? (exclusive=ExclusiveNew | vars+=NewVar[/,/])?
;

// Exclusive NEW: (var) means NEW all except var
ExclusiveNew:
    '(' except+=VARNAME[/,/] ')'
;

NewVar:
    name=VARNAME subscripts=Subscripts?
;

// KILL command: K|KILL killarglist
// killarglist = comma-separated killarguments
// killargument = glvn (selective) | (L lname) (exclusive)
// Multiple exclusive groups: keep only vars in ALL groups (intersection)
// Mixed: K (X,W),Z means exclusive kill keeping X,W, then also kill Z
// Note: K with no space before next command means kill all.
// K<space>VAR means kill VAR. K<space><space>CMD means kill all then CMD.
KillCommand:
    /[Kk][Ii][Ll][Ll]|[Kk]/ postcond=Postcondition? (' ' args+=KillArgument[/,/])?
;

KillArgument:
    exclusive?='(' except+=VARNAME[/,/] ')' | target=KillTarget
;

// KILL target can be a naked global, global, local variable, or indirection (@expr)
// NakedGlobal MUST come before GlobalVariable since both start with ^
// NakedGlobal is ^(...) while GlobalVariable is ^name(...)
KillTarget:
    NakedGlobal | GlobalVariable | Indirection | LocalVariable
;

// =============================================================================
// Other Commands
// =============================================================================

// HANG command: H|HANG seconds
HangCommand:
    /[Hh][Aa][Nn][Gg]|[Hh]/ postcond=Postcondition? WS seconds=Expr
;

// HALT command: H|HALT (same abbreviation as HANG - context determines by argument)
// Per MUMPS spec: H alone = HALT, H followed by expression = HANG
// The !WS negative lookahead ensures H alone (or at end of line) matches HALT
// while H followed by space+expression will NOT match, falling through to HangCommand
HaltCommand:
    /[Hh][Aa][Ll][Tt]|[Hh]/ !WS postcond=Postcondition?
;

// BREAK command: B|BREAK
BreakCommand:
    /[Bb][Rr][Ee][Aa][Kk]|[Bb]/ postcond=Postcondition?
;

// LOCK command: L|LOCK targets
// Note: Like KillCommand, requires single space before targets to distinguish
// "L target" (lock target) from "L  CMD" (unlock all, then next command)
// Also supports parenthesized list: L (^A,^B):timeout
// Supports indirection: L @A, L @A:1, L (@A,^B):1
LockCommand:
    /[Ll][Oo][Cc][Kk]|[Ll]/ postcond=Postcondition? (' ' lockop=LockOp? (locklist=LockList | targets+=LockTarget[/,/]))?
;

LockOp:
    '+' | '-'
;

// Parenthesized lock list: (targets):timeout
// Supports indirection within the list: L (@A,^B,@C):1
LockList:
    '(' targets+=LockListItem[/,/] ')' (':' timeout=Expr)?
;

// Lock list item: either indirection or variable reference
LockListItem:
    indirect=IndirectChain | target=VarRef
;

// Lock target: variable or indirection with optional postcondition and timeout
LockTarget:
    postcond=Postcondition? (indirect=IndirectChain | target=VarRef) (':' timeout=Expr)?
;

// Helper rule for global or local variable reference
VarRef:
    GlobalVariable | LocalVariable
;

// MERGE command: M|MERGE dest=source
MergeCommand:
    /[Mm][Ee][Rr][Gg][Ee]|[Mm]/ postcond=Postcondition? WS merges+=MergeArg[/,/]
;

MergeArg:
    dest=VarRef '=' src=VarRef
;

// VIEW command: V|VIEW args
ViewCommand:
    /[Vv][Ii][Ee][Ww]|[Vv]/ postcond=Postcondition? WS? args+=Expr[/,/]?
;

// XECUTE command: X|XECUTE expr
XecuteCommand:
    /[Xx][Ee][Cc][Uu][Tt][Ee]|[Xx]/ postcond=Postcondition? WS args+=XecuteArg[/,/]
;

XecuteArg:
    postcond=Postcondition? expr=Expr
;

// JOB command: JOB label:(processparams):timeout
// Full syntax per MUMPS 1995 MDC 8.2.10:
//   J label^routine(actuallist):(processparameters):timeout
// Examples from VistA:
//   J ^XMRONT::5                     - routine with timeout only
//   J START^XWBVLL(PORT)::5          - routine with args and timeout
//   J CHILDONT^%ZISTCPS(NIO,RTN):(:16::):10  - full syntax with processparams
//   J SSVNJOB1:(IN="/dev/null":OUT="/dev/null") - processparams without timeout
JobCommand:
    /[Jj]([Oo][Bb])?/ postcond=Postcondition? WS targets+=JobTarget[/,/]
;

// JOB target: extends DoTarget with optional processparameters and timeout
// Syntax: label^routine(args):(processparams):timeout
// - actuallist: passed via DoTarget's args=FunctionArgs
// - processparameters: implementation-specific (partition size, device settings)
// - timeout: affects $TEST, optional
// The :: syntax (empty processparams) is equivalent to :():
//   J ^XMRONT::5 means J ^XMRONT:():5 (empty processparams, 5 second timeout)
JobTarget:
    (
        // Indirection: @expr, @@expr, @expr+offset, @expr^routine, etc.
        indirect=DoIndirect |
        // Regular label reference
        label=LabelRef args=FunctionArgs?
    ) postcond=Postcondition?
    // Optional processparameters and/or timeout
    // Supports: :timeout, :(params), :(params):timeout, ::timeout (empty params)
    (
        // :(params) optionally followed by :timeout
        ':' '(' processparams+=Expr[/:/]? ')' (':' timeout=Expr)? |
        // ::timeout (empty processparams) - shorthand for :():timeout
        '::' timeout=Expr |
        // :timeout only (single colon with numeric value)
        ':' timeout=Expr
    )?
;

// OPEN command: OPEN device[:timeout] or OPEN device:(params)[:timeout]
// Examples:
//   O X - simple open
//   O X:1 - open with timeout
//   O X:(params) - open with parameters
//   O DEV:("AVL4":0:2048) - open with multiple params
OpenCommand:
    /[Oo]([Pp][Ee][Nn])?/ postcond=Postcondition? WS args+=OpenArg[/,/]
;

// Open argument: device with optional parameters and timeout
// Supports:
//   X - device only
//   X:timeout - device with timeout
//   X:(params) - device with parameters
//   X:(params):timeout - device with parameters and timeout
//   X::timeout - device with empty params and timeout (double colon)
OpenArg:
    device=Expr (
        ':' (
            // Parenthesized parameters: :(param:param:...):
            '(' params+=Expr[':'] ')' (':' timeout=Expr)? |
            // Empty params with timeout: ::timeout (double colon)
            ':' timeout=Expr |
            // Simple timeout: :timeout
            timeout=Expr
        )
    )?
;

// CLOSE command: CLOSE device[:parameters]
// Per MUMPS 1995 spec, CLOSE supports optional device parameters
CloseCommand:
    /[Cc]([Ll][Oo][Ss][Ee])?/ postcond=Postcondition? WS args+=CloseArg[/,/]
;

// Close argument: device with optional parameters
// Supports:
//   X - device only
//   X:(params) - device with parameters
CloseArg:
    device=Expr (
        ':' (
            // Parenthesized parameters: :(param:param:...)
            '(' params+=Expr[':'] ')'
        )
    )?
;

// USE command: USE device[:parameters]
// Per MUMPS 1995 spec, USE supports optional device parameters
UseCommand:
    /[Uu]([Ss][Ee])?/ postcond=Postcondition? WS args+=UseArg[/,/]
;

// Use argument: device with optional parameters
// Supports:
//   X - device only
//   X:(params) - device with parameters
UseArg:
    device=Expr (
        ':' (
            // Parenthesized parameters: :(param:param:...)
            '(' params+=Expr[':'] ')'
        )
    )?
;

// =============================================================================
// Shared Elements
// =============================================================================

// Command postcondition: :condition
Postcondition:
    ':' condition=Expr
;

// Whitespace (explicit since skipws=False)
WS:
    /[ \t]+/
;

// Single space only (used where double-space has semantic meaning)
SingleSpace:
    /[ \t]/
;
