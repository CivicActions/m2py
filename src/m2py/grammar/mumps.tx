// MUMPS Routine Structure Grammar for textX
// =============================================================================
// Parses routine-level structure: labels, lines, formal parameters.
// Line content is parsed separately via line.tx → commands.tx/expressions.tx.
// See docs/architecture.md "Two-Layer Architecture" for details.
// Whitespace-sensitive: skipws=False in metamodel
// =============================================================================

// Root element - a complete MUMPS routine
Routine:
    lines*=Line
;

// A line - label line (starts with letter/%) or continuation (starts with whitespace) or comment
Line:
    LabelLine | ContLine | CommentLine | EmptyLine
;

// Label line: label at column 1 (letter/% or numeric), optional formal params, then rest
// Labels can be: NAME, %NAME, or NUMERIC
LabelLine:
    label=LABEL_NAME formal_list=FormalList? rest=/[^\r\n]*/ NL
;

// Formal parameter list: (param1, param2, ...)
FormalList:
    '(' params+=PARAM_NAME[/,/] ')'
;

// Continuation line: starts with tab or single space, then rest
// Note: Dot level indicators (per MUMPS spec §6.2) appear in the 'rest' content,
// not as the linestart character. E.g., " . S X=1" starts with space, dot is in rest.
ContLine:
    /[\t ]/ rest=/[^\r\n]*/ NL
;

// Comment-only line: starts with semicolon at column 1
CommentLine:
    /;[^\r\n]*/ NL
;

// Empty line: just whitespace and newline  
EmptyLine:
    /[ \t]*/ NL
;

// Newline
NL:
    /\r?\n/
;

// =============================================================================
// Terminal Rules
// =============================================================================

// Label name: letter or %, followed by alphanumeric, or just digits
LABEL_NAME:
    /[A-Za-z%][A-Za-z0-9]*|[0-9]+/
;

// Parameter name for formal list
PARAM_NAME:
    /[ \t]*[A-Za-z%][A-Za-z0-9]*/
;
