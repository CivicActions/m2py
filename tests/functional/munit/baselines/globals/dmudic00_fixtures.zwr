^DD("IX",1514,0)="1009.802^ADUALC^MU^MU^^R^IR^I^1009.802^^^^^S"
^DD("IX",1514,.1,0)="^^19^19^3060521009.802"
^DD("IX",1514,.1,1,0)="This cross reference is used to maintain the dual REGULAR ""C"" cross "
^DD("IX",1514,.1,2,0)="reference on the ABBREVIATION(#1) field and the VA STATE CODE(#2) field "
^DD("IX",1514,.1,3,0)="and replaces the SET and KILL logic on the REGULAR traditional cross "
^DD("IX",1514,.1,4,0)="reference.  The REGULAR traditional cross references SET and KILL "
^DD("IX",1514,.1,5,0)="logic are set to a ""Q"" so look ups will not error out."
^DD("IX",1514,.1,6,0)=" "
^DD("IX",1514,.1,7,0)="1009.802,1           ABBREVIATION           0;2 FREE TEXT (Required)"
^DD("IX",1514,.1,8,0)="              CROSS-REFERENCE:  1009.802^C "
^DD("IX",1514,.1,9,0)="                                1)= Q"
^DD("IX",1514,.1,10,0)="                                2)= Q"
^DD("IX",1514,.1,11,0)="                                3)= Used in conjunction with the 'ADUALC' "
^DD("IX",1514,.1,12,0)="                                    xref."
^DD("IX",1514,.1,13,0)=" "
^DD("IX",1514,.1,14,0)="1009.802,2           VA STATE CODE          0;3 FREE TEXT"
^DD("IX",1514,.1,15,0)="              CROSS-REFERENCE:  1009.802^C "
^DD("IX",1514,.1,16,0)="                                1)= Q"
^DD("IX",1514,.1,17,0)="                                2)= Q"
^DD("IX",1514,.1,18,0)="                                3)= Used in conjunction with the 'ADUALC' "
^DD("IX",1514,.1,19,0)="                                    xref."
^DD("IX",1514,1)="I ((X2(1)'="""")!(X1(1)'=X2(1))),X2(1)'="""" S ^DMU(1009.802,""C"",X2(1),DA)="""" I ((X2(2)'="""")!(X1(2)'=X2(2))),X2(2)'="""" S ^DMU(1009.802,""C"",X2(2),DA)="""" Q"
^DD("IX",1514,2)="I ((X2(1)="""")!(X1(1)'=X2(1))),X1(1)'="""" K ^DMU(1009.802,""C"",X1(1),DA) I ((X2(2)="""")!(X1(2)'=X2(2))),X1(2)'="""" K ^DMU(1009.802,""C"",X1(2),DA) Q"
