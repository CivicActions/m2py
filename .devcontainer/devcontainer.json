{
    "name": "Strict Python Sandbox",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-extra/features/uv:1": {},
        "ghcr.io/devcontainers-extra/features/ruff:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers-extra/features/pre-commit:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/ripgrep:1": {}
    },
    
    // Explicitly mount ONLY the local workspace folder to a specific path in the container
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    // Disable the automatic mounting of the VS Code home folder/settings
    "mounts": [
        // Mount the worktrees folder to persist any git worktrees created during development
        "source=${localEnv:HOME}/workspace/m2py.worktrees,target=/workspaces/m2py.worktrees,type=bind,consistency=cached"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "charliermarsh.ruff"
            ],
            "settings": {
                // Prevents VS Code from trying to sync local history into the container
                "terminal.integrated.inheritEnv": false
            }
        }
    }, 
    "postCreateCommand": "chmod +x .devcontainer/setup.sh && ./.devcontainer/setup.sh",
    "remoteUser": "vscode"
}